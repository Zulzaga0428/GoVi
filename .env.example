# Railway → Variables хэсэгт эдгээрийг тохируулна.
# Локалд ажиллуулахдаа энэ файлыг .env.local нэрээр хуулж утгыг нь бөглөнө.

# PostgreSQL холболт. Railway дээр Postgres нэмэхэд ӨӨРӨӨ орж ирнэ.
# Тохируулаагүй бол мэдээ data/reports.json файлд хадгалагдаж,
# дахин байршуулах бүрд АРИЛНА. Прод дээр заавал тохируулна.
DATABASE_URL=

# Нэвтрэх код. Хоосон бол хуудас нээлттэй — линктэй хүн бүр бичиж чадна.
# Тохируулбал /app болон бүх API код шаардана.
ACCESS_CODE=

# Нүүр хуудсан дээрх амьд тоог унтраах бол "off" гэж бичнэ.
# Анхдагчаар асаалттай — ажиллаж байгааг нотлох хамгийн хүчтэй зүйл.
LANDING_LIVE=
